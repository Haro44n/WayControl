pkgname=waycontrol
pkgver=0.1.0
pkgrel=1
pkgdesc='Authenticated Android companion daemon for Wayland desktops'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'systemd' 'pipewire' 'playerctl' 'gtk3')
optdepends=('nvidia-utils: NVIDIA GPU telemetry')
makedepends=('cargo')
options=('!debug' '!lto')

# Build directly from the checked-out source tree. Run makepkg from this directory.
source=()
sha256sums=()

_project_root="$startdir/../.."

build() {
    cd "$_project_root"
    cargo build --locked --offline --release -p waycontrol-server
}

package() {
    install -Dm755 "$_project_root/target/release/waycontrold" "$pkgdir/usr/bin/waycontrold"
    install -Dm644 "$startdir/waycontrol.service" "$pkgdir/usr/lib/systemd/user/waycontrol.service"
    install -Dm644 "$_project_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$_project_root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$_project_root/docs/INSTALL_ARCH.md" "$pkgdir/usr/share/doc/$pkgname/INSTALL_ARCH.md"
    install -Dm644 "$_project_root/SECURITY.md" "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
}
